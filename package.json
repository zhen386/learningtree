{
  "name": "learning-tree",
  "productName": "学习树",
  "version": "1.0.0",
  "description": "学习树：可扩充、可标记进度、可引用资源的思维导图",
  "main": "desktop/main.js",
  "private": true,
  "author": "学习树",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "dist:dir": "electron-builder --win dir",
    "test": "electron test/smoke.js"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "local.learningtree",
    "productName": "学习树",
    "artifactName": "LearningTree-${version}-setup.${ext}",

    "directories": { "output": "dist" },
    "files": [
      "index.html",
      "css/**",
      "js/**",
      "desktop/**",
      "package.json"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "desktop/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "学习树"
    },
    "portable": {
      "artifactName": "LearningTree-${version}-portable.${ext}"
    }
  }
}
